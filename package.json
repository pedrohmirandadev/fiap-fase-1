{
  "name": "oficina-tech-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:migrate": "bun src/infrastructure/database/migrate.ts",
    "db:seed": "bun src/infrastructure/database/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "test": "bun test",
    "test:memory": "bun --cwd=tests test in-memory.test.ts",
    "test:coverage": "bun test --coverage",
    "mocks:generate": "bun scripts/generate-test-mocks.ts",
    "mocks:check": "bun scripts/generate-test-mocks.ts --check",
    "typecheck": "tsc --noEmit",
    "security:audit": "bun audit"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/jwt": "^1.3.0",
    "@elysia/openapi": "^1.3.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.3.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
